# Local development settings. Copy to .env (gitignored); mise loads it automatically.
#
# !!! Use the Hetzner DEV project only. Never put the production token here. !!!

NEXUS_ENV=dev
NEXUS_API_TOKEN=change-me-to-a-long-random-string
DATABASE_URL=postgresql+asyncpg://nexus:nexus@localhost:5432/nexus

# --- Hetzner (dev project) ---
HCLOUD_TOKEN=
# Name (or id) of the dev project's Primary IP. auto_delete must be off.
HCLOUD_PRIMARY_IP=nexus-dev
# Safety net: nexus refuses to start in dev if this token can see the prod Primary IP.
HCLOUD_FORBIDDEN_PRIMARY_IP=nexus-prod
HCLOUD_SERVER_TYPE=cx32
# Restrict SSH to your own address while developing, e.g. 198.51.100.7/32
SSH_ALLOWED_CIDRS=0.0.0.0/0,::/0

# ed25519 keys, OpenSSH format. Generate with:
#   ssh-keygen -t ed25519 -N '' -C nexus-client -f nexus-client
#   ssh-keygen -t ed25519 -N '' -C nexus-host -f nexus-host
# and paste the private keys (multi-line values in double quotes).
SSH_CLIENT_KEY=
SSH_HOST_KEY=

# The name players connect to; defaults to the Primary IP's address.
PUBLIC_HOSTNAME=

# --- Discord (leave DISCORD_TOKEN empty to run without the bot) ---
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_NOTIFY_CHANNEL_ID=
# Comma-separated role IDs. Empty viewer list = every guild member may view.
DISCORD_ROLES_VIEWER=
DISCORD_ROLES_OPERATOR=
DISCORD_ROLES_ADMIN=

# --- Game secrets: NEXUS_GAME_<GAME>_<KEY> for each recipe's secret_env ---
NEXUS_GAME_VALHEIM_SERVER_PASSWORD=

#cloud-config
# Rendered by nexus (infra/cloudinit.py). Every host is disposable: game data lives on
# ymir and is pushed here on start and pulled back on stop.
ssh_pwauth: false
disable_root: true

users:
  - name: {{ ssh_user }}
    groups: [docker]
    sudo: "ALL=(ALL) NOPASSWD:ALL"
    shell: /bin/bash
    lock_passwd: true
    ssh_authorized_keys:
      - {{ client_public_key }}

# Pin the host key so nexus can verify every fresh VM without trust-on-first-use.
ssh_deletekeys: true
ssh_genkeytypes: []
ssh_keys:
  ed25519_private: |
{{ host_private_key | indent(4, first=True) }}
  ed25519_public: {{ host_public_key }}

package_update: true
packages:
  - zstd

write_files:
  - path: /etc/docker/daemon.json
    content: |
      {"log-driver": "json-file", "log-opts": {"max-size": "20m", "max-file": "3"}}

runcmd:
  - [systemctl, restart, docker]
  - [mkdir, -p, {{ games_dir }}]
{%- if registry_token %}
  - [sh, -c, "echo '{{ registry_token }}' | docker login ghcr.io -u '{{ registry_user }}' --password-stdin"]
{%- endif %}
  - [install, -d, -m, "700", -o, {{ ssh_user }}, {{ env_dir }}]
  - [touch, {{ ready_marker }}]
